
{
  "id": "c5-patches",
  "name": "Creator 5 Patches",
  "version": "1.1.3",
  "description": "Custom patches for the FlashForge Creator 5.",
  "klippy_extras": [
    "scripts/c5_pickup_patch.py",
    "scripts/afc_restore_patch.py"
  ],
  "moonraker_components": [
    "scripts/kalico_runtime_patch.py"
  ],
  "startup": [
    {
      "name": "c5-patch-excludes",
      "exec": "scripts/c5-patches.sh",
      "type": "once"
    }
  ],
  "scripts": {
    "install": "install.sh",
    "update": "update.sh",
    "uninstall": "uninstall.sh"
  },
  "restart": [
    "klipper",
    "moonraker"
  ]
}
